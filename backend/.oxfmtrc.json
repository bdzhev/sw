{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 80,
  "trailingComma": "es5",
  "arrowParens": "always",
  "bracketSpacing": true,
  "ignorePatterns": ["**/dist/**", "**/src/shared/db/migrations/**"],
  "sortImports": {
    "newlinesBetween": true,
    "ignoreCase": true
  }
}
