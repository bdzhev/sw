# --- Required ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sw

# --- Auto-generated by init.sh ---
JWT_SECRET=

# --- Docker defaults (change if needed) ---
FRONTEND_URL=http://localhost:5173

# Leave loopback (or empty) and the app talks to the API on whatever host served
# the page — which is what lets a phone on the wifi work. Set it only when the
# API genuinely lives elsewhere.
API_URL=http://localhost:3000

# Comma-separated CORS allow-list for a real deployment. Unset means "any
# private-network origin", which is what LAN play needs.
# ALLOWED_ORIGINS=https://sw.example.com

# --- Local dev only (not used in Docker) ---
DATABASE_URL=postgresql://localhost:5432/sw
